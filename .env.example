# Copy to .env and fill in. Names only here — never commit values (SPEC.md §7).
# Values come from the dev infrastructure bootstrap output (docs/dev-environment.md).

# PostgreSQL — reached through the SSH tunnel (pnpm db:tunnel), so the host is
# localhost:5433. Per-developer database, e.g. platform_devski (SPEC.md §4).
DATABASE_URL=
# Separate test database (platform_test_<github-handle> — SPEC.md §6)
DATABASE_URL_TEST=

# SSH target of the dev instance for the tunnel, e.g. ubuntu@<instance-ip>
DEV_SSH_HOST=

# OVHcloud Object Storage (S3) — used only by src/lib/storage.ts (G1).
# Endpoint format: https://s3.<region>.io.cloud.ovh.net
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_KEY=
S3_SECRET=
# Key prefix scoping this environment inside the bucket (SPEC §4):
# `devski/` per developer, `pr-7/` per preview; leave empty in production.
S3_PREFIX=

# Transactional e-mail (#22). Leave EMAIL_API_KEY blank and the app logs every
# message instead of sending it — that is the local and test default.
# Scaleway's own .env snippet names these SCW_SECRET_KEY and
# SCW_DEFAULT_PROJECT_ID; SCW_ACCESS_KEY is for signed APIs and is unused here.
EMAIL_API_KEY=
EMAIL_PROJECT_ID=
# Must be an address on a domain verified in TEM, or the provider refuses it.
EMAIL_FROM=
# Optional; defaults to fr-par.
EMAIL_REGION=

# Application
APP_URL=
AUTH_SECRET=
# `production` enables search-engine indexing (A7); anything else — local,
# dev, a PR preview — sends `X-Robots-Tag: noindex`. Set by the deployment.
APP_ENV=
