# Copy to .env and fill in. Names only here — never commit values (SPEC.md §7).

# PostgreSQL (per-developer database, e.g. platform_devski — SPEC.md §4)
DATABASE_URL=
# Separate test database (platform_test_<github-handle> — SPEC.md §6)
DATABASE_URL_TEST=

# OVHcloud Object Storage (S3) — used only by src/lib/storage.ts (G1)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_KEY=
S3_SECRET=

# Transactional e-mail (Scaleway TEM; dev uses a log transport — plan #6)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=

# Application
APP_URL=
AUTH_SECRET=
