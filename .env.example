# Copy to .env and fill in. Names only here — never commit values (SPEC.md §7).
# Values come from the dev infrastructure bootstrap output (docs/dev-environment.md).

# PostgreSQL — reached through the SSH tunnel (pnpm db:tunnel), so the host is
# localhost:5433. Per-developer database, e.g. platform_devski (SPEC.md §4).
DATABASE_URL=
# Separate test database (platform_test_<github-handle> — SPEC.md §6)
DATABASE_URL_TEST=

# The database's deadlines (#172). All optional: leaving them blank keeps the
# numbers in src/db/client.ts, which are sized for dev's one-core instance
# shared by dev and every open preview. Production's managed database (#24)
# is a different machine with a different connection cap and sets its own.
# A whole number of milliseconds; 0 turns that bound off.
# Connections this container may hold at once.
DB_POOL_MAX=
# How long a request waits for a free connection before it is answered with
# an error. Never 0 in a deployed environment: 0 means it waits for ever.
DB_CONNECT_TIMEOUT_MS=
# How long one statement may run before the server cuts it off.
DB_STATEMENT_TIMEOUT_MS=
# How long one statement may wait for a lock another transaction holds.
DB_LOCK_TIMEOUT_MS=

# SSH target of the dev instance for the tunnel, e.g. ubuntu@<instance-ip>
DEV_SSH_HOST=
# Hostname the dev deployment answers on (SPEC §8). Leave empty and
# wire-dev-deploy.sh falls back to <ip>.nip.io, which needs no DNS.
SITE_ADDRESS=

# OVHcloud Object Storage (S3) — used only by src/lib/storage.ts (G1).
# Endpoint format: https://s3.<region>.io.cloud.ovh.net
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_KEY=
S3_SECRET=
# Key prefix scoping this environment inside the bucket (SPEC §4):
# `devski/` per developer, `pr-7/` per preview; leave empty in production.
S3_PREFIX=

# Transactional e-mail (#22). Leave EMAIL_API_KEY blank and the app logs every
# message instead of sending it — that is the local and test default.
# Scaleway's own .env snippet names these SCW_SECRET_KEY and
# SCW_DEFAULT_PROJECT_ID; SCW_ACCESS_KEY is for signed APIs and is unused here.
EMAIL_API_KEY=
EMAIL_PROJECT_ID=
# Shown to the reader instead of the bare address, on the sender and on the
# reply address. Leave empty and only the address is shown.
EMAIL_FROM_NAME=
# Must be an address on a domain verified in TEM, or the provider refuses it.
EMAIL_FROM=
# Optional; defaults to fr-par.
EMAIL_REGION=
# Optional, and worth setting: the sending domain's MX points at the provider,
# which discards everything, so a reply to a verification e-mail would vanish.
# It must therefore be an address on a DIFFERENT domain from EMAIL_FROM — one
# with a real mailbox behind its MX. An address on the sending domain looks
# right and fails identically to having no Reply-To at all.
EMAIL_REPLY_TO=

# Application
APP_URL=
AUTH_SECRET=
# `production` enables search-engine indexing (A7); anything else — local,
# dev, a PR preview — sends `X-Robots-Tag: noindex`. Set by the deployment.
APP_ENV=
