# Everything the image must not carry. The build context is uploaded to the
# builder, so this is both a size and a secrets concern.
.git
.github
node_modules
.next
.env
.env.*
.pglite-data
.design
coverage
playwright-report
test-results
e2e
# Excluded with e2e/, not on its own account: it imports ./e2e/server-log,
# and `next build` type-checks the whole project — so leaving it behind
# breaks the image build on a module that is not in the context.
playwright.config.ts
docs
tasks
scripts/dev-local.mjs
**/*.test.ts
**/*.test.tsx
Dockerfile
.dockerignore
