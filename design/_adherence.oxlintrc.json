{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "components/profile/**",
              "ui_kits/app/**",
              "ui_kits/public-web/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Figtree|Fira Sans Condensed|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Figtree, Fira Sans Condensed, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AboutProfile'] > JSXAttribute > JSXIdentifier[name!=/^(?:displayName|handle|avatarUrl|avatarShape|headline|bio|places|key|ref|className|style|children)$/]",
        "message": "<AboutProfile> doesn't accept that prop. Declared props: displayName, handle, avatarUrl, avatarShape, headline, bio, places."
      },
      {
        "selector": "JSXOpeningElement[name.name='AboutProfile'] > JSXAttribute[name.name='avatarShape'] > Literal[value!=/^(?:circle|square)$/]",
        "message": "<AboutProfile> avatarShape must be one of 'circle' | 'square'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|size|square|alt|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, name, size, square, alt, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|uppercase|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, uppercase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|success|danger|warning|ink)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'success' | 'danger' | 'warning' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|fullWidth|disabled|loading|href|type|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, fullWidth, disabled, loading, href, type, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|quiet|ghost|onPhoto|onPhotoQuiet)$/]",
        "message": "<Button> variant must be one of 'solid' | 'quiet' | 'ghost' | 'onPhoto' | 'onPhotoQuiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<Button> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|padding|as|tone|interactive|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, padding, as, tone, interactive, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='padding'] > Literal[value!=/^(?:none|sm|md|lg)$/]",
        "message": "<Card> padding must be one of 'none' | 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:div|section|article|form|li)$/]",
        "message": "<Card> as must be one of 'div' | 'section' | 'article' | 'form' | 'li'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|sunken)$/]",
        "message": "<Card> tone must be one of 'default' | 'sunken'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|spacing|style|key|ref|className|style|children)$/]",
        "message": "<Divider> doesn't accept that prop. Declared props: label, spacing, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|body|action|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: icon, title, body, action, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute > JSXIdentifier[name!=/^(?:company|links|locale|onLocaleChange|copyright|note|style|key|ref|className|style|children)$/]",
        "message": "<Footer> doesn't accept that prop. Declared props: company, links, locale, onLocaleChange, copyright, note, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|htmlFor|hint|error|status|children|style|key|ref|className|style|children)$/]",
        "message": "<FormField> doesn't accept that prop. Declared props: label, htmlFor, hint, error, status, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HandleField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|origin|value|onChange|state|message|hint|id|style|key|ref|className|style|children)$/]",
        "message": "<HandleField> doesn't accept that prop. Declared props: label, origin, value, onChange, state, message, hint, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HandleField'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:idle|checking|available|taken|reserved|own|invalid)$/]",
        "message": "<HandleField> state must be one of 'idle' | 'checking' | 'available' | 'taken' | 'reserved' | 'own' | 'invalid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|tone|strokeWidth|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, tone, strokeWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:body|muted|strong|onPhoto|success|danger)$/]",
        "message": "<Icon> tone must be one of 'body' | 'muted' | 'strong' | 'onPhoto' | 'success' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|size|tone|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, size, tone, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:quiet|bordered|onPhoto)$/]",
        "message": "<IconButton> tone must be one of 'quiet' | 'bordered' | 'onPhoto'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|type|invalid|disabled|mono|size|prefix|placeholder|autoComplete|maxLength|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: value, onChange, type, invalid, disabled, mono, size, prefix, placeholder, autoComplete, maxLength, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|email|password|tel|url)$/]",
        "message": "<Input> type must be one of 'text' | 'email' | 'password' | 'tel' | 'url'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<Input> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LocaleSwitcher'] > JSXAttribute > JSXIdentifier[name!=/^(?:locales|names|current|onChange|tone|style|key|ref|className|style|children)$/]",
        "message": "<LocaleSwitcher> doesn't accept that prop. Declared props: locales, names, current, onChange, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LocaleSwitcher'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|onPhoto)$/]",
        "message": "<LocaleSwitcher> tone must be one of 'default' | 'onPhoto'."
      },
      {
        "selector": "JSXOpeningElement[name.name='OrbitTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:poster|name|cues|autorotate|ring|aspect|onEnlarge|onOpen|openLabel|radius|style|key|ref|className|style|children)$/]",
        "message": "<OrbitTile> doesn't accept that prop. Declared props: poster, name, cues, autorotate, ring, aspect, onEnlarge, onOpen, openLabel, radius, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoUpload'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|size|emptyLabel|chooseLabel|hint|busy|busyLabel|onChoose|style|key|ref|className|style|children)$/]",
        "message": "<PhotoUpload> doesn't accept that prop. Declared props: src, name, size, emptyLabel, chooseLabel, hint, busy, busyLabel, onChoose, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Plaque'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|footer|scale|minWidth|shadow|decorative|style|key|ref|className|style|children)$/]",
        "message": "<Plaque> doesn't accept that prop. Declared props: name, footer, scale, minWidth, shadow, decorative, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProfileBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:profile|brand|solid|aboutOpen|onToggleAbout|toggleDisabled|phone|actions|style|key|ref|className|style|children)$/]",
        "message": "<ProfileBar> doesn't accept that prop. Declared props: profile, brand, solid, aboutOpen, onToggleAbout, toggleDisabled, phone, actions, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusMessage'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|plain|style|key|ref|className|style|children)$/]",
        "message": "<StatusMessage> doesn't accept that prop. Declared props: children, tone, plain, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusMessage'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:info|success|danger|warning)$/]",
        "message": "<StatusMessage> tone must be one of 'info' | 'success' | 'danger' | 'warning'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|onClick|tone|underline|icon|style|key|ref|className|style|children)$/]",
        "message": "<TextLink> doesn't accept that prop. Declared props: children, href, onClick, tone, underline, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:strong|muted|onPhoto)$/]",
        "message": "<TextLink> tone must be one of 'strong' | 'muted' | 'onPhoto'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute[name.name='underline'] > Literal[value!=/^(?:hover|always)$/]",
        "message": "<TextLink> underline must be one of 'hover' | 'always'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopBarItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|key|ref|className|style|children)$/]",
        "message": "<TopBarItem> doesn't accept that prop. Declared props: id, label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Work'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|name|href|investor|developer|description|cover|thumbs|orbit|key|ref|className|style|children)$/]",
        "message": "<Work> doesn't accept that prop. Declared props: id, name, href, investor, developer, description, cover, thumbs, orbit."
      }
    ]
  },
